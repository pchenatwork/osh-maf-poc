# Origin of the FHIR API. Leave EMPTY for local development: an empty value
# keeps requests same-origin so the Vite proxy in vite.config.ts forwards
# /fhir to http://localhost:5080.
#
# For a deployed build set it to the Render service URL, with no trailing
# slash, e.g.
#   VITE_API_BASE_URL=https://osh-maf-api.onrender.com
#
# Vite inlines this at BUILD time, so changing it requires a rebuild. In CI it
# is supplied by the workflow rather than by a committed .env file.
VITE_API_BASE_URL=
