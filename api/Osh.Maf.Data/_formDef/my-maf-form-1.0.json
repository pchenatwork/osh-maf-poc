  "id": "my-maf-form-1-0",
  "url": "http://schools.nyc.gov/osh/Questionnaire/my-maf",
  "version": "1.0",
  "name": "MyMafForm",
  "title": "Toy MAF Form — risk panel",
  "status": "active",
  "experimental": true,
  "subjectType": [
    "Patient"
  ],
  "date": "2026-09-06",
  "description": "Exercises ChoiceControl (horizontal Y/N/U rows with conditional follow-ups, plus a matrix of every presentation), the risk panel in its one standard shape — one group per line item — and the label-orientation extension.",
  "item": [
    {
      "linkId": "how-it-works",
      "text": "Run-time form generation. The server returns one FHIR R4 Questionnaire and the renderer walks its item tree, choosing a control per item.type - a group becomes a section, a choice becomes the buttons below built from its answerOption codes, and enableWhen decides what appears as you answer. Your entries are collected into a QuestionnaireResponse that mirrors the same tree, stores each answer as a typed FHIR value, and pins this definition by url|version. A new form is therefore a new JSON definition, not new code.",
      "type": "display",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-displayCategory",
          "valueCodeableConcept": {
            "coding": [
              {
                "system": "http://hl7.org/fhir/questionnaire-display-category",
                "code": "instructions"
              }
            ]
          }
        }
      ]
    },
    {
