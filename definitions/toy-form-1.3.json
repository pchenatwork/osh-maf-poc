    {
      "linkId": "display-demo",
      "text": "DisplayControl categories (Plain, instructions, security, help, (uncategorized), xhtml)",
      "type": "group",
      "item": [
        {
          "linkId": "d.plain",
          "type": "display",
          "text": "1. Plain display, no category. This is how the eight consent paragraphs render — body text the reader is agreeing to, not a hint.\nThis second line proves authored line breaks survive."
        },
        {
          "linkId": "d.instructions",
          "type": "display",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-displayCategory",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-display-category",
                    "code": "instructions"
                  }
                ]
              }
            }
          ],
          "text": "2. instructions — how to fill the form in. Subordinate to the questions."
        },
        {
          "linkId": "d.security",
          "type": "display",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-displayCategory",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-display-category",
                    "code": "security"
                  }
                ]
              }
            }
          ],
          "text": "3. security — how this information will be handled. The one category given visual weight, because it should stop the reader."
        },
        {
          "linkId": "d.help",
          "type": "display",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-displayCategory",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-display-category",
                    "code": "help"
                  }
                ]
              }
            }
          ],
          "text": "4. help — the spec says this is not necessarily rendered inline at all, so it renders quietly."
        },
        {
          "linkId": "d.unknown-category",
          "type": "display",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-displayCategory",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-display-category",
                    "code": "not-a-real-code"
                  }
                ]
              }
            }
          ],
          "text": "5. (Unrecognised category code) — falls back to a plain paragraph. An unknown category must never cost the reader the text."
        },
        {
          "linkId": "d.xhtml",
          "type": "display",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/rendering-xhtml",
              "valueString": "<b onmouseover=\"alert(1)\">markup from the server</b>"
            }
          ],
          "text": "6. xhtml - This item carries a rendering-xhtml extension with an event handler in it. The markup is dropped and you are reading item.text instead — that is the control working, not failing."
        }
      ]
    },
